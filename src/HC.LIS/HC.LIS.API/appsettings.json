{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "Enabled": true,
    "Global": { "PermitLimit": 100, "WindowSeconds": 60, "QueueLimit": 0 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
    "Stream": { "PermitLimit": 5, "QueueLimit": 0 }
  }
}
